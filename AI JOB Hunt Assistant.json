      "name": "Add Scores to Jobs"
    },
    {
      "parameters": {
        "jsCode": "// Map JSearch results into clean jobs, keeping only\n// fresher-friendly tech roles in India (or remote).\n\nconst out = [];\nlet seen = 0;\n\n// Titles to skip: senior roles\nconst seniorTitle = /\\b(senior|sr\\.?|lead|manager|principal|staff|architect|head|director)\\b/i;\n\n// Title must contain at least one tech word\nconst techTitle = /\\b(ai|ml|machine learning|data|python|software|developer|engineer|sde|programmer|llm|nlp|gen ?ai|computer vision|automation|backend|analyst|scientist|it)\\b/i;\n\n// Titles to skip: non-tech or core-engineering roles\nconst nonTech = /\\b(sales|medical|recruit|sourcing|bpo|voice|telecall|customer support|marketing|hr|accountant|nurse|teacher|tutor|business development|mechanical|civil|electrical|chemical|production|site|manufacturing|maintenance|hardware|network|field)\\b/i;\n\n// Smallest number of years asked for, e.g. \"3+ years\", \"4-6 yrs\"\nconst minYears = (text) => {\n  const m = [...String(text || '').matchAll(/(\\d{1,2})\\s*(?:\\+|-\\s*\\d{1,2})?\\s*(?:years|yrs)/gi)];\n  if (!m.length) return 0;\n  return Math.min(...m.map((x) => Number(x[1])));\n};\n\nfor (const { json: raw } of $input.all()) {\n  let res = raw;\n  if (typeof res.data === 'string') {\n    try { res = JSON.parse(res.data); } catch (e) {}\n  }\n\n  const list = res.job_title\n    ? [res]\n    : Array.isArray(res.data) ? res.data : (res.data?.jobs || res.jobs || []);\n\n  for (const j of list) {\n    seen++;\n    const title = j.job_title || '';\n\n    // 1. India or remote only\n    const country = String(j.job_country || '').toUpperCase();\n    if (country && country !== 'IN' && country !== 'INDIA' && !j.job_is_remote) continue;\n\n    // 2. Skip senior titles\n    if (seniorTitle.test(title)) continue;\n\n    // 3. Keep only tech titles, skip non-tech\n    if (!techTitle.test(title) || nonTech.test(title)) continue;\n\n    // 4. Skip jobs needing 2+ years\n    const months = j.job_required_experience?.required_experience_in_months;\n    if (months && months >= 24) continue;\n    if (minYears(j.job_description) >= 3) continue;\n\n    out.push({\n      json: {\n        title,\n        company: j.employer_name || '',\n        location: [j.job_city, j.job_state].filter(Boolean).join(', ') || (j.job_is_remote ? 'Remote' : ''),\n        link: j.job_apply_link || '',\n        source: j.job_publisher || 'JSearch',\n        details: String(j.job_description || '').slice(0, 1500),\n      },\n    });\n  }\n}\n\nif (!out.length) {\n  throw new Error(`0 jobs kept after filters. Jobs seen: ${seen}.`);\n}\n\nreturn out;\n"
      },
