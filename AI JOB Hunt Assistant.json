      "id": "ef497a72-aa6a-4c30-8f97-6da2a6d19327",
      "name": "Get Saved Jobs",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        1344,
        208
      ],
      "executeOnce": true,
      "alwaysOutputData": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "xCXVaqvZnYVQb4QE",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst limit = Number(cfg.maxJobsPerRun) || 15;\n\nconst saved = new Set(\n  $('Get Saved Jobs').all()\n    .map((i) => String(i.json['Job ID'] ?? ''))\n    .filter(Boolean)\n);\n\nconst all = $('Normalize Jobs').all();\nconst fresh = cfg.testMode ? all : all.filter((i) => !saved.has(i.json.jobId));\n\nconsole.log(`Jobs found: ${all.length}, already saved: ${saved.size}, new: ${fresh.length}`);\n\nreturn fresh.slice(0, limit).map((i) => ({ json: i.json }));"
      },
