    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst esc = (s) => String(s ?? '')\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;');\n\nconst top = $('Prepare Good Rows').all()\n  .map((i) => i.json)\n  .sort((a, b) => {\n    const hydA = /hyderabad/i.test(a['Location']) ? 1 : 0;\n    const hydB = /hyderabad/i.test(b['Location']) ? 1 : 0;\n    return (hydB - hydA) || (b['Score'] - a['Score']);\n  })\n  .slice(0, cfg.topN);\n\nreturn top.map((j, idx) => {\n  const link = j['Link'] && j['Link'].startsWith('http')\n    ? j['Link']\n    : 'https://www.google.com/search?q=' + encodeURIComponent(`${j['Title']} ${j['Company']} job`);\n\n  const text =\n    `<b>#${idx + 1} of ${top.length} · ${j['Score']}% match</b>\\n` +\n    `<b>${esc(j['Title'])}</b>\\n` +\n    `🏢 ${esc(j['Company'])}   📍 ${esc(j['Location'] || 'N/A')}   🔎 ${esc(j['Source'])}\\n\\n` +\n    `✅ <b>Matching:</b> ${esc(j['Matching Skills'] || '-')}\\n` +\n    `⚠️ <b>Missing:</b> ${esc(j['Missing Skills'] || 'none')}\\n` +\n    `💡 ${esc(j['Reason'])}\\n\\n` +\n    `🔗 <a href=\"${esc(link)}\">Apply here</a>`;\n\n  return { json: { jobId: j['Job ID'], link, text } };\n});"
      },
