        "jsCode": "const jobs = $('Good Match').all(0);\nconst today = $now.setZone('Asia/Kolkata').toFormat('yyyy-MM-dd');\n\nreturn $input.all().map((item, i) => {\n  const j = jobs[i].json;\n  return {\n    json: {\n      'Job ID': j.jobId,\n      'Title': j.title,\n      'Company': j.company,\n      'Location': j.location,\n      'Link': j.link,\n      'Source': j.source,\n      'Score': Number(j.match_score),\n      'Matching Skills': (j.matching_skills || []).join(', '),\n      'Missing Skills': (j.missing_skills || []).join(', '),\n      'Reason': j.reason || '',\n      'Cover Letter': String(item.json.text || '').trim(),\n      'Status': 'New',\n      'Date Found': today,\n      'Updated On': today,\n    },\n  };\n});"
